    {"id":"course3-repeating-decimals-fractions-review-003","type":"multiple_choice","questionText":"Convert 0.151515... to a fraction before simplifying.","options":["15/99","15/100","15/999","1/15"],"correctAnswer":"15/99","difficulty":"scaffold","answerType":"number","skillTags":["computation"],"explanation":"The two-digit block 15 repeats, so the denominator is 99."},
    {"id":"course3-repeating-decimals-fractions-review-004","type":"multiple_choice","questionText":"Simplify 15/99.","options":["5/33","3/20","5/30","1/9"],"correctAnswer":"5/33","difficulty":"scaffold","answerType":"number","skillTags":["computation"],"explanation":"Divide numerator and denominator by 3."},
    {"id":"course3-repeating-decimals-fractions-review-005","type":"multiple_choice","questionText":"For x = 0.676767..., which multiplier lines up one full repeating block?","options":["100","10","1000","67"],"correctAnswer":"100","difficulty":"scaffold","answerType":"number","skillTags":["conceptual"],"explanation":"The block 67 has two digits, so multiply by 100."},
    {"id":"course3-repeating-decimals-fractions-review-006","type":"multiple_choice","questionText":"Convert 0.030303... to a fraction in simplest form.","options":["1/33","3/100","3/90","1/30"],"correctAnswer":"1/33","difficulty":"scaffold","answerType":"number","skillTags":["computation"],"explanation":"3/99 simplifies to 1/33."},
    {"id":"course3-repeating-decimals-fractions-review-007","type":"multiple_choice","questionText":"What is 0.999... exactly?","options":["1","0.99","99/100","Less than 1"],"correctAnswer":"1","difficulty":"scaffold","answerType":"number","skillTags":["conceptual"],"explanation":"The repeating decimal 0.999... is exactly equal to 1."},
    {"id":"course3-repeating-decimals-fractions-review-008","type":"multiple_choice","questionText":"Convert -0.555... to a fraction.","options":["-5/9","-1/5","5/9","-5/10"],"correctAnswer":"-5/9","difficulty":"scaffold","answerType":"number","skillTags":["computation"],"explanation":"0.555... = 5/9, then retain the negative sign."},
    {"id":"course3-repeating-decimals-fractions-review-009","type":"multiple_choice","questionText":"Convert 0.242424... to a fraction in simplest form.","options":["8/33","24/100","6/25","2/11"],"correctAnswer":"8/33","difficulty":"standard","answerType":"number","skillTags":["computation"],"explanation":"24/99 simplifies by 3 to 8/33."},
    {"id":"course3-repeating-decimals-fractions-review-010","type":"multiple_choice","questionText":"Convert 0.111111... to a fraction.","options":["1/9","1/10","10/99","1/11"],"correctAnswer":"1/9","difficulty":"standard","answerType":"number","skillTags":["computation"],"explanation":"The repeating digit 1 gives 1/9."},
    {"id":"course3-repeating-decimals-fractions-review-011","type":"multiple_choice","questionText":"Convert 1.666... to an improper fraction.","options":["5/3","16/10","4/3","14/9"],"correctAnswer":"5/3","difficulty":"standard","answerType":"number","skillTags":["computation"],"explanation":"1.666... = 1 + 2/3 = 5/3."},
    {"id":"course3-repeating-decimals-fractions-review-012","type":"multiple_choice","questionText":"Convert 0.1333..., where only the 3 repeats, to a fraction.","options":["2/15","13/99","1/8","4/25"],"correctAnswer":"2/15","difficulty":"standard","answerType":"number","skillTags":["computation"],"explanation":"Use (13 - 1)/90 = 12/90 = 2/15."},
    {"id":"course3-repeating-decimals-fractions-review-013","type":"multiple_choice","questionText":"Which denominator comes before simplifying 0.456456...?","options":["999","1000","99","900"],"correctAnswer":"999","difficulty":"standard","answerType":"number","skillTags":["conceptual"],"explanation":"The repeating block has three digits."},
    {"id":"course3-repeating-decimals-fractions-review-014","type":"multiple_choice","questionText":"Convert 0.456456... to a fraction in simplest form.","options":["152/333","456/1000","19/40","46/99"],"correctAnswer":"152/333","difficulty":"standard","answerType":"number","skillTags":["computation"],"explanation":"456/999 simplifies by 3 to 152/333."},
    {"id":"course3-repeating-decimals-fractions-review-015","type":"multiple_choice","questionText":"A student says 0.313131... = 31/100. Which correction is needed?","options":["Use 31/99 because the block repeats","Use 13/99 because the digits reverse","Use 31/10 because there are two digits","The decimal is irrational"],"correctAnswer":"Use 31/99 because the block repeats","difficulty":"standard","answerType":"number","skillTags":["reasoning"],"explanation":"A repeating two-digit block uses denominator 99, while 31/100 equals terminating 0.31."},
    {"id":"course3-repeating-decimals-fractions-review-016","type":"multiple_choice","questionText":"Which fraction has decimal form 0.727272...?","options":["8/11","72/100","7/9","18/25"],"correctAnswer":"8/11","difficulty":"standard","answerType":"number","skillTags":["reasoning"],"explanation":"72/99 simplifies to 8/11."},
    {"id":"course3-repeating-decimals-fractions-review-017","type":"multiple_choice","questionText":"Convert 0.08333..., where only the 3 repeats, to a fraction.","options":["1/12","8/99","1/10","5/72"],"correctAnswer":"1/12","difficulty":"standard","answerType":"number","skillTags":["computation"],"explanation":"0.08333... is the decimal expansion of 1/12; algebra gives (83 - 8)/900 = 75/900 = 1/12."},
    {"id":"course3-repeating-decimals-fractions-review-018","type":"multiple_choice","questionText":"Which step checks that 5/11 = 0.454545...?","options":["Compute 5 ÷ 11","Compute 5 × 11","Add 5 + 11","Round 5/11 to a whole number"],"correctAnswer":"Compute 5 ÷ 11","difficulty":"standard","answerType":"number","skillTags":["reasoning"],"explanation":"Dividing the numerator by the denominator produces the decimal form."},
