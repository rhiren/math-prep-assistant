{
  "testId": "course3-integer-exponents-core",
  "conceptId": "concept-integer-exponents",
  "type": "concept",
  "title": "Integer Exponents Core Test",
  "description": "Interpret and evaluate powers, apply positive-integer exponent laws, analyze signs, and simplify numerical and algebraic expressions.",
  "questions": [
    {"id":"course3-integer-exponents-core-001","type":"multiple_choice","questionText":"In the expression 5³, what is the base?","options":["5","3","15","125"],"correctAnswer":"5","difficulty":"scaffold","answerType":"number","skillTags":["conceptual"],"explanation":"The base is the repeated factor. In 5³, the factor 5 is used three times."},
    {"id":"course3-integer-exponents-core-002","type":"multiple_choice","questionText":"What does the exponent 4 mean in 7⁴?","options":["Use 7 as a factor four times","Multiply 7 by 4","Add four 7s","Use 4 as a factor seven times"],"correctAnswer":"Use 7 as a factor four times","difficulty":"scaffold","answerType":"text","skillTags":["conceptual"],"explanation":"7⁴ means 7 × 7 × 7 × 7."},
    {"id":"course3-integer-exponents-core-003","type":"multiple_choice","questionText":"Evaluate 2⁵.","options":["32","10","25","64"],"correctAnswer":"32","difficulty":"scaffold","answerType":"number","skillTags":["computation"],"explanation":"2⁵ = 2 × 2 × 2 × 2 × 2 = 32."},
    {"id":"course3-integer-exponents-core-004","type":"multiple_choice","questionText":"Evaluate 3⁴.","options":["81","12","64","27"],"correctAnswer":"81","difficulty":"scaffold","answerType":"number","skillTags":["computation"],"explanation":"3⁴ = 3 × 3 × 3 × 3 = 81."},
    {"id":"course3-integer-exponents-core-005","type":"multiple_choice","questionText":"Evaluate (-2)³.","options":["-8","8","-6","6"],"correctAnswer":"-8","difficulty":"scaffold","answerType":"number","skillTags":["computation"],"explanation":"Three negative factors have a negative product: (-2)(-2)(-2) = -8."},
    {"id":"course3-integer-exponents-core-006","type":"multiple_choice","questionText":"Evaluate (-2)⁴.","options":["16","-16","8","-8"],"correctAnswer":"16","difficulty":"scaffold","answerType":"number","skillTags":["computation"],"explanation":"Four negative factors make a positive product: (-2)⁴ = 16."},
    {"id":"course3-integer-exponents-core-007","type":"multiple_choice","questionText":"Evaluate -2⁴.","options":["-16","16","-8","8"],"correctAnswer":"-16","difficulty":"scaffold","answerType":"number","skillTags":["reasoning"],"explanation":"Without parentheses, the exponent applies to 2 first: -2⁴ = -(2⁴) = -16."},
    {"id":"course3-integer-exponents-core-008","type":"multiple_choice","questionText":"Which repeated multiplication represents x³?","options":["x × x × x","3 × x","x + x + x","x × 3 × 3"],"correctAnswer":"x × x × x","difficulty":"scaffold","answerType":"text","skillTags":["conceptual"],"explanation":"The exponent 3 means x appears as a factor three times."},
    {"id":"course3-integer-exponents-core-009","type":"multiple_choice","questionText":"Simplify x² × x⁴.","options":["x⁶","x⁸","x²","2x⁶"],"correctAnswer":"x⁶","difficulty":"scaffold","answerType":"text","skillTags":["computation"],"explanation":"For the same base, add exponents: x² × x⁴ = x²⁺⁴ = x⁶."},
    {"id":"course3-integer-exponents-core-010","type":"multiple_choice","questionText":"For y ≠ 0, simplify y⁷ ÷ y³.","options":["y⁴","y¹⁰","y²¹","4y"],"correctAnswer":"y⁴","difficulty":"scaffold","answerType":"text","skillTags":["computation"],"explanation":"For the same nonzero base, subtract exponents: y⁷ ÷ y³ = y⁷⁻³ = y⁴."},
    {"id":"course3-integer-exponents-core-011","type":"multiple_choice","questionText":"Simplify a³ × a⁵.","options":["a⁸","a¹⁵","a²","2a⁸"],"correctAnswer":"a⁸","difficulty":"standard","answerType":"text","skillTags":["computation"],"explanation":"The bases match, so add the exponents: 3 + 5 = 8."},
    {"id":"course3-integer-exponents-core-012","type":"multiple_choice","questionText":"For m ≠ 0, simplify m⁹ ÷ m⁴.","options":["m⁵","m¹³","m³⁶","5m"],"correctAnswer":"m⁵","difficulty":"standard","answerType":"text","skillTags":["computation"],"explanation":"Subtract the exponents on the common base: 9 - 4 = 5."},
    {"id":"course3-integer-exponents-core-013","type":"multiple_choice","questionText":"Simplify (p³)⁴.","options":["p¹²","p⁷","p⁸¹","4p³"],"correctAnswer":"p¹²","difficulty":"standard","answerType":"text","skillTags":["computation"],"explanation":"For a power of a power, multiply the exponents: 3 × 4 = 12."},
    {"id":"course3-integer-exponents-core-014","type":"multiple_choice","questionText":"Simplify (2x)³.","options":["8x³","2x³","6x³","8x"],"correctAnswer":"8x³","difficulty":"standard","answerType":"text","skillTags":["computation"],"explanation":"The exponent applies to both factors: (2x)³ = 2³x³ = 8x³."},
    {"id":"course3-integer-exponents-core-015","type":"multiple_choice","questionText":"Simplify (ab)⁴.","options":["a⁴b⁴","ab⁴","a⁴b","4ab"],"correctAnswer":"a⁴b⁴","difficulty":"standard","answerType":"text","skillTags":["computation"],"explanation":"A power of a product applies to each factor: (ab)⁴ = a⁴b⁴."},
    {"id":"course3-integer-exponents-core-016","type":"multiple_choice","questionText":"Simplify (x/3)².","options":["x²/9","x²/3","2x/6","x/9"],"correctAnswer":"x²/9","difficulty":"standard","answerType":"text","skillTags":["computation"],"explanation":"Square the numerator and denominator: (x/3)² = x²/3² = x²/9."},
    {"id":"course3-integer-exponents-core-017","type":"multiple_choice","questionText":"Write 2³ × 2⁴ as one power of 2.","options":["2⁷","2¹²","2¹","4⁷"],"correctAnswer":"2⁷","difficulty":"standard","answerType":"text","skillTags":["computation"],"explanation":"The bases match, so add exponents: 2³ × 2⁴ = 2³⁺⁴ = 2⁷."},
    {"id":"course3-integer-exponents-core-018","type":"multiple_choice","questionText":"Write 5⁶ ÷ 5² as one power of 5.","options":["5⁴","5⁸","5³","1⁴"],"correctAnswer":"5⁴","difficulty":"standard","answerType":"text","skillTags":["computation"],"explanation":"Subtract the exponents: 5⁶ ÷ 5² = 5⁶⁻² = 5⁴."},
    {"id":"course3-integer-exponents-core-019","type":"multiple_choice","questionText":"Write (3²)³ as one power of 3.","options":["3⁶","3⁵","3⁸","9⁶"],"correctAnswer":"3⁶","difficulty":"standard","answerType":"text","skillTags":["computation"],"explanation":"Multiply the exponents: (3²)³ = 3²×³ = 3⁶."},
    {"id":"course3-integer-exponents-core-020","type":"multiple_choice","questionText":"Simplify x × x⁴.","options":["x⁵","x⁴","x⁶","2x⁴"],"correctAnswer":"x⁵","difficulty":"standard","answerType":"text","skillTags":["conceptual","computation"],"explanation":"The factor x is x¹. Therefore x¹ × x⁴ = x⁵."},
    {"id":"course3-integer-exponents-core-021","type":"multiple_choice","questionText":"Simplify 4x² × 3x⁵.","options":["12x⁷","7x⁷","12x¹⁰","12x³"],"correctAnswer":"12x⁷","difficulty":"standard","answerType":"text","skillTags":["computation"],"explanation":"Multiply coefficients to get 12 and add the exponents on x: 2 + 5 = 7."},
    {"id":"course3-integer-exponents-core-022","type":"multiple_choice","questionText":"For a ≠ 0, simplify 10a⁶ ÷ 2a².","options":["5a⁴","8a⁴","5a³","20a⁸"],"correctAnswer":"5a⁴","difficulty":"standard","answerType":"text","skillTags":["computation"],"explanation":"10 ÷ 2 = 5 and a⁶ ÷ a² = a⁴, so the result is 5a⁴."},
    {"id":"course3-integer-exponents-core-023","type":"multiple_choice","questionText":"Simplify (2m²)³.","options":["8m⁶","6m⁶","8m⁵","2m⁶"],"correctAnswer":"8m⁶","difficulty":"standard","answerType":"text","skillTags":["computation"],"explanation":"Cube the coefficient and multiply the exponents: 2³(m²)³ = 8m⁶."},
    {"id":"course3-integer-exponents-core-024","type":"multiple_choice","questionText":"Simplify (3xy)².","options":["9x²y²","6x²y²","9xy²","3x²y²"],"correctAnswer":"9x²y²","difficulty":"standard","answerType":"text","skillTags":["computation"],"explanation":"Square every factor: 3²x²y² = 9x²y²."},
    {"id":"course3-integer-exponents-core-025","type":"multiple_choice","questionText":"Simplify (a²b³)².","options":["a⁴b⁶","a⁴b⁵","a²b⁶","a⁸b⁹"],"correctAnswer":"a⁴b⁶","difficulty":"standard","answerType":"text","skillTags":["computation"],"explanation":"Multiply each inside exponent by 2: a²×²b³×² = a⁴b⁶."},
    {"id":"course3-integer-exponents-core-026","type":"multiple_choice","questionText":"Which single power is equivalent to 2³ × 5³?","options":["10³","7³","10⁶","2¹⁵"],"correctAnswer":"10³","difficulty":"standard","answerType":"text","skillTags":["reasoning"],"explanation":"The exponents match, so combine the bases: 2³ × 5³ = (2 × 5)³ = 10³."},
    {"id":"course3-integer-exponents-core-027","type":"multiple_choice","questionText":"For x ≠ 0, simplify 12x⁵ ÷ 3x².","options":["4x³","9x³","4x⁷","4x²"],"correctAnswer":"4x³","difficulty":"standard","answerType":"text","skillTags":["computation"],"explanation":"12 ÷ 3 = 4 and x⁵ ÷ x² = x³."},
    {"id":"course3-integer-exponents-core-028","type":"multiple_choice","questionText":"Which comparison is true?","options":["2⁶ = 4³","2⁶ > 4³","2⁶ < 4³","2⁶ = 8³"],"correctAnswer":"2⁶ = 4³","difficulty":"standard","answerType":"text","skillTags":["reasoning"],"explanation":"2⁶ = 64 and 4³ = 64, so the powers are equal."},
    {"id":"course3-integer-exponents-core-029","type":"multiple_choice","questionText":"A student claims x³ + x³ = x⁶. What is the correct simplification?","options":["2x³","x⁶","2x⁶","x⁹"],"correctAnswer":"2x³","difficulty":"standard","answerType":"text","skillTags":["conceptual","reasoning"],"explanation":"The product rule does not apply to addition. Two like terms x³ + x³ combine to 2x³."},
    {"id":"course3-integer-exponents-core-030","type":"multiple_choice","questionText":"Which expression is equivalent to x²y²?","options":["(xy)²","(x + y)²","xy⁴","(xy)⁴"],"correctAnswer":"(xy)²","difficulty":"standard","answerType":"text","skillTags":["reasoning"],"explanation":"A power distributes across a product: (xy)² = x²y²."},
    {"id":"course3-integer-exponents-core-031","type":"multiple_choice","questionText":"A square has side length 3x². Which expression represents its area?","options":["9x⁴","6x⁴","9x²","3x⁴"],"correctAnswer":"9x⁴","difficulty":"standard","answerType":"text","skillTags":["application"],"explanation":"Area is side squared: (3x²)² = 3²x⁴ = 9x⁴."},
    {"id":"course3-integer-exponents-core-032","type":"multiple_choice","questionText":"A cube has edge length 2a². Which expression represents its volume?","options":["8a⁶","6a⁶","8a⁵","4a⁶"],"correctAnswer":"8a⁶","difficulty":"standard","answerType":"text","skillTags":["application"],"explanation":"Volume is edge cubed: (2a²)³ = 2³a⁶ = 8a⁶."},
    {"id":"course3-integer-exponents-core-033","type":"multiple_choice","questionText":"Evaluate (2²)³ ÷ 2².","options":["16","8","32","4"],"correctAnswer":"16","difficulty":"standard","answerType":"number","skillTags":["computation"],"explanation":"(2²)³ ÷ 2² = 2⁶ ÷ 2² = 2⁴ = 16."},
    {"id":"course3-integer-exponents-core-034","type":"multiple_choice","questionText":"Find n if xⁿ × x⁵ = x¹².","options":["7","17","60","2"],"correctAnswer":"7","difficulty":"standard","answerType":"number","skillTags":["reasoning"],"explanation":"The product rule gives n + 5 = 12, so n = 7."},
    {"id":"course3-integer-exponents-core-035","type":"multiple_choice","questionText":"Find n if (x³)ⁿ = x¹⁵.","options":["5","12","18","45"],"correctAnswer":"5","difficulty":"standard","answerType":"number","skillTags":["reasoning"],"explanation":"A power of a power gives 3n = 15, so n = 5."},
    {"id":"course3-integer-exponents-core-036","type":"multiple_choice","questionText":"Simplify (a⁴ × a³)².","options":["a¹⁴","a⁹","a²⁴","a⁷"],"correctAnswer":"a¹⁴","difficulty":"challenge","answerType":"text","skillTags":["computation","reasoning"],"explanation":"First a⁴ × a³ = a⁷. Then (a⁷)² = a¹⁴."},
    {"id":"course3-integer-exponents-core-037","type":"multiple_choice","questionText":"For x ≠ 0, simplify (x⁸ ÷ x³)².","options":["x¹⁰","x⁷","x¹⁶","x²²"],"correctAnswer":"x¹⁰","difficulty":"challenge","answerType":"text","skillTags":["computation"],"explanation":"Inside the parentheses, x⁸ ÷ x³ = x⁵. Then (x⁵)² = x¹⁰."},
    {"id":"course3-integer-exponents-core-038","type":"multiple_choice","questionText":"Simplify (2x³y)² × 3xy².","options":["12x⁷y⁴","6x⁶y⁴","12x⁴y³","12x⁷y³"],"correctAnswer":"12x⁷y⁴","difficulty":"challenge","answerType":"text","skillTags":["computation"],"explanation":"(2x³y)² = 4x⁶y². Multiplying by 3xy² gives 12x⁷y⁴."},
    {"id":"course3-integer-exponents-core-039","type":"multiple_choice","questionText":"For a ≠ 0 and b ≠ 0, simplify 6a⁵b³ ÷ 2a²b.","options":["3a³b²","4a³b²","3a⁷b⁴","3a²b³"],"correctAnswer":"3a³b²","difficulty":"challenge","answerType":"text","skillTags":["computation"],"explanation":"Divide coefficients and subtract exponents by base: 6/2 = 3, a⁵/a² = a³, and b³/b = b²."},
    {"id":"course3-integer-exponents-core-040","type":"multiple_choice","questionText":"Simplify ((2m)³)².","options":["64m⁶","32m⁶","64m⁵","8m⁶"],"correctAnswer":"64m⁶","difficulty":"challenge","answerType":"text","skillTags":["computation"],"explanation":"((2m)³)² = (2m)⁶ = 2⁶m⁶ = 64m⁶."},
    {"id":"course3-integer-exponents-core-041","type":"multiple_choice","questionText":"For x ≠ 0, simplify (3x²)² ÷ 3x.","options":["3x³","6x³","3x²","9x³"],"correctAnswer":"3x³","difficulty":"challenge","answerType":"text","skillTags":["computation"],"explanation":"(3x²)² = 9x⁴. Dividing by 3x gives 3x³."},
    {"id":"course3-integer-exponents-core-042","type":"multiple_choice","questionText":"Simplify (a²b)³ × (ab²)².","options":["a⁸b⁷","a⁷b⁸","a⁶b⁶","a¹⁰b⁹"],"correctAnswer":"a⁸b⁷","difficulty":"challenge","answerType":"text","skillTags":["computation"],"explanation":"The factors become a⁶b³ and a²b⁴. Multiply to get a⁸b⁷."},
    {"id":"course3-integer-exponents-core-043","type":"multiple_choice","questionText":"A student writes (x²)³ = x⁵. Which correction explains the error?","options":["Multiply the exponents to get x⁶","Add one more x to get x⁶","Square 3 to get x⁹","Keep only the outside exponent to get x³"],"correctAnswer":"Multiply the exponents to get x⁶","difficulty":"challenge","answerType":"text","skillTags":["conceptual","reasoning"],"explanation":"A power of a power represents three groups of x², so the exponents multiply: 2 × 3 = 6."},
    {"id":"course3-integer-exponents-core-044","type":"multiple_choice","questionText":"Evaluate 4⁵ ÷ 2⁶.","options":["16","8","32","64"],"correctAnswer":"16","difficulty":"challenge","answerType":"number","skillTags":["computation","reasoning"],"explanation":"4⁵ = (2²)⁵ = 2¹⁰. Then 2¹⁰ ÷ 2⁶ = 2⁴ = 16."},
    {"id":"course3-integer-exponents-core-045","type":"multiple_choice","questionText":"Evaluate (8³ × 2⁴) ÷ 4².","options":["512","256","1024","128"],"correctAnswer":"512","difficulty":"challenge","answerType":"number","skillTags":["computation","reasoning"],"explanation":"Rewrite with base 2: 8³ = 2⁹ and 4² = 2⁴. Then 2⁹ × 2⁴ ÷ 2⁴ = 2⁹ = 512."},
    {"id":"course3-integer-exponents-core-046","type":"multiple_choice","questionText":"Find n if (xⁿ)³ × x² = x²⁰.","options":["6","18","22","9"],"correctAnswer":"6","difficulty":"challenge","answerType":"number","skillTags":["reasoning"],"explanation":"The left side is x³ⁿ⁺², so 3n + 2 = 20. Thus 3n = 18 and n = 6."},
    {"id":"course3-integer-exponents-core-047","type":"multiple_choice","questionText":"If every side length of a square is doubled, by what factor is its area multiplied?","options":["4","2","8","16"],"correctAnswer":"4","difficulty":"challenge","answerType":"number","skillTags":["application","reasoning"],"explanation":"Area uses the second power of length. Doubling length multiplies area by 2² = 4."},
    {"id":"course3-integer-exponents-core-048","type":"multiple_choice","questionText":"If every edge length of a cube is tripled, by what factor is its volume multiplied?","options":["27","9","3","81"],"correctAnswer":"27","difficulty":"challenge","answerType":"number","skillTags":["application","reasoning"],"explanation":"Volume uses the third power of length. Tripling an edge multiplies volume by 3³ = 27."},
    {"id":"course3-integer-exponents-core-049","type":"multiple_choice","questionText":"For a ≠ 0 and b ≠ 0, simplify ((ab)²)³ ÷ a²b.","options":["a⁴b⁵","a⁵b⁴","a⁴b⁶","a⁸b⁷"],"correctAnswer":"a⁴b⁵","difficulty":"challenge","answerType":"text","skillTags":["computation"],"explanation":"((ab)²)³ = a⁶b⁶. Dividing by a²b leaves a⁴b⁵."},
    {"id":"course3-integer-exponents-core-050","type":"multiple_choice","questionText":"For x ≠ 0 and y ≠ 0, simplify (2x²y)³ ÷ 4xy.","options":["2x⁵y²","4x⁵y²","2x⁶y³","2x⁴y²"],"correctAnswer":"2x⁵y²","difficulty":"challenge","answerType":"text","skillTags":["computation"],"explanation":"The numerator is 8x⁶y³. Dividing by 4xy gives 2x⁵y²."}
  ]
}
